{{ define "main" }}
  <link rel="stylesheet" type="text/css" href="/styles/main.css">
  <article class="post">
    <div class="pageHeader">
      <div class="postHeader">
        <h1 class="postTitle">{{ .Title }}</h1>
        <p class="postDesc">{{ .Params.description }}</p>
        <div class="postDetail">
          <img src={{.Params.avatar}} alt="" loading="lazy" class="postAvatar" />
          <span>
            {{range .GetTerms "authors" }}
            <a href={{.Permalink}}>{{.Name}}</a>
            {{end}}
          </span>
          {{range .GetTerms "categories" }}
          <a href={{.Permalink}} class="postCategories">{{.Name}}</a>
          {{end}}
        </div>
        <time>{{dateFormat .Site.Params.dateFormat .Date}}</time>
      </div>
      <img src={{.Params.imageCover}} loading="lazy" class="postCover" alt=""/>
    </div>
    
    <div class="postContent">
    {{ .Content }}
    </div>
  </article>
    <div class="moreContent">
    {{ .Content }}
    </div>
{{ end }}
